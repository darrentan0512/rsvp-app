{
  "name": "rsvp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"API_PORT=3001 node --env-file-if-exists=.env --watch --no-warnings server/index.js\" \"vite\"",
