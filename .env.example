# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables instead.

# Database (Turso). Leave empty locally to use a SQLite file in data/rsvp.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email delivery via Resend (https://resend.com). Leave RESEND_API_KEY empty to run in
# preview mode: emails are rendered and logged in the app but not delivered.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="Gather <invites@yourdomain.com>"

# Public URL of the app, used for links in emails. On Vercel this defaults to the
# project's production domain; set it if you use a custom domain.
APP_URL=http://localhost:5173

# Shared secret Vercel Cron sends to /api/cron/reminders (any long random string).
CRON_SECRET=
